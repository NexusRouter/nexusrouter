# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# OS
.DS_Store

# Logs
logs
*.log
*.log.*

# Root Node (husky 等工具链)
/node_modules/

# Frontend (web/dashboard/)
web/dashboard/node_modules/
web/dashboard/dist/
web/dashboard/dist-ssr/
web/dashboard/.next/
web/dashboard/build/
web/dashboard/.vite/
web/dashboard/coverage/
web/dashboard/.eslintcache

# ---- Intermediate / local build artifacts (do not commit) ----
# TypeScript incremental (project references / tsc -b)
*.tsbuildinfo

# Test & coverage (repo root or tools)
coverage/
*.lcov
.nyc_output/
htmlcov/

# Analytics / script outputs (e.g. data skills default paths)
output/

# Local temp (e.g. air live reload, ad-hoc scripts)
tmp/

# ESLint cache (monorepo root)
.eslintcache

# Go CPU / mem profiles from benchmarks
*.prof
*.pprof

# Gateway default SQLite (default path: services/gateway/gateway.db; override: NEXUSROUTER_SQLITE_PATH)
services/gateway/gateway.db
services/gateway/**/gateway.db

# Gateway admin uploads (vendor logos; override: NEXUSROUTER_UPLOADS_DIR)
services/gateway/data/uploads/

# JetBrains IDE (local)
.idea/

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Optional local env overrides (keep .env.example tracked if you use one)
.env.local
.env.*.local

# 本地自动同步：脚本、模板、停止标记、临时摘要、归档日志与快照（不纳入版本库）
scripts/autosync*.sh
scripts/perpetual-sync-loop.sh
scripts/env.autosync.example
scripts/prompts/autosync*
.env.autosync
.autosync-last-feature-summary.txt
.stop-autosync-loop
.stop-sync-loop
docs/spec-archive/autosync*
docs/spec-archive/openspec-snapshot-*